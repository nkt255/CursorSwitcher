<Window x:Class="CursorSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorSwitcher"
        Width="700" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1a1d24"
        Foreground="#f0f0f0"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Style 1" FontWeight="SemiBold" Margin="6,4,0,4" Foreground="#dfe7ff"/>
        <Border Grid.Row="1" BorderBrush="#5c6477" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Style1PathBox" Grid.Column="0" Height="32" Margin="6" Background="#111821" Foreground="#f3f3f3" BorderBrush="#3f4a5a" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse .ani" Width="120" Height="32" Margin="0,6,6,6" Click="BrowseStyle1_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Style 2 (Windows default)" FontWeight="SemiBold" Margin="6,4,0,4" Foreground="#dfe7ff"/>
        <Border Grid.Row="3" BorderBrush="#5c6477" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Style2PathBox" Grid.Column="0" Height="32" Margin="6" Background="#111821" Foreground="#f3f3f3" BorderBrush="#3f4a5a" VerticalContentAlignment="Center" Text="Windows 11 default" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="Use default" Width="120" Height="32" Margin="0,6,6,6" Click="UseDefaultCursor_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderBrush="#5c6477" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Background="#121923">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hotkey binding" FontWeight="SemiBold" Foreground="#dfe7ff" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="HotkeyBox" Grid.Column="0" Height="34" Margin="0,0,10,0" Background="#111821" Foreground="#f3f3f3" BorderBrush="#3f4a5a" VerticalContentAlignment="Center" Text="F9" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Bind hotkey" Height="34" Click="BindHotkey_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Save" Width="120" Height="36" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Grid.Column="2" Content="Apply Style 1" Width="140" Height="36" Click="ApplyStyle1_Click"/>
        </Grid>
    </Grid>
</Window>
